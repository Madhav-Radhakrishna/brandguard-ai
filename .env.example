# ============================================================
# BrandGuard AI — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# --- Supabase (browser-safe, public) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Supabase service-role key (SERVER ONLY — Vercel env vars) ---
# Used only in /api/* serverless functions, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Google Gemini API (SERVER ONLY — Vercel env vars) ---
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model names — check https://ai.google.dev/models for current names.
# We use: gemini-1.5-flash (generation) and text-embedding-004 (embeddings, dim=768)
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
